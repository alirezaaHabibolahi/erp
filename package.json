{
  "name": "erp",
  "version": "0.0.1",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15 <25 || >=26"
  },
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit && node node_modules/@nestjs/cli/bin/nest.js build",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit",
    "format": "node node_modules/prettier/bin/prettier.cjs --write \"src/**/*.ts\" \"libs/**/*.ts\" \"prisma/**/*.ts\" \"*.{json,md,mts}\" \"docs/**/*.md\" --no-error-on-unmatched-pattern",
    "start": "node node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "node node_modules/eslint/bin/eslint.js \"{src,apps,libs,test,prisma}/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "prisma:format": "node node_modules/prisma/build/index.js format",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate:dev": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:studio": "node node_modules/prisma/build/index.js studio",
    "prisma:validate": "node node_modules/prisma/build/index.js validate",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "prepare": "husky install",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:cov": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:debug": "node --inspect-brk node_modules/vitest/vitest.mjs run --pool=forks --poolOptions.forks.singleFork",
    "test:e2e": "node node_modules/vitest/vitest.mjs run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "file-type": "18",
    "graphql": "^16.11.0",
    "graphql-request": "6.1.0",
    "husky": "^9.1.7",
    "ioredis": "5.6.1",
    "jalali-moment": "^3.3.11",
    "jszip": "^3.10.1",
    "lint-staged": "^17.1.1",
    "moment-jalaali": "^0.10.4",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "persian-date": "^1.1.0",
    "pg": "^8.23.0",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^3.0.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.7",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "webpack-node-externals": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
