enum ScopeType {
  ALL     @map("all")
  COMPANY @map("company")
  BRANCH  @map("branch")
  OWN     @map("own")
  CUSTOM  @map("custom")

  @@map("scope_type")
}

enum PermissionEffect {
  ALLOW @map("allow")
  DENY  @map("deny")

  @@map("permission_effect")
}

model User {
  id                String    @id @default(cuid())
  phone             String    @unique
  username          String?   @unique
  email             String?   @unique
  passwordHash      String?   @map("password_hash")
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  displayName       String?   @map("display_name")
  avatarUrl         String?   @map("avatar_url") @db.Text
  isVerified        Boolean   @default(false) @map("is_verified")
  isActive          Boolean   @default(true) @map("is_active")
  settings          Json      @default("{}")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  sessions            AuthSession[]
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  auditLogs           AuditLog[]

  @@index([isActive])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent") @db.Text
  isRevoked        Boolean   @default(false) @map("is_revoked")
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([isRevoked])
  @@map("auth_sessions")
}

model System {
  id          String   @id @default(cuid())
  code        Int      @unique
  key         String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  resources Resource[]

  @@map("systems")
}

model Resource {
  id          String   @id @default(cuid())
  systemCode  Int      @map("system_code")
  code        Int
  key         String
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  system      System       @relation(fields: [systemCode], references: [code], onDelete: Restrict)
  permissions Permission[]

  @@unique([systemCode, code])
  @@unique([systemCode, key])
  @@index([systemCode])
  @@map("resources")
}

model Action {
  id          String   @id @default(cuid())
  code        Int      @unique
  key         String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions Permission[]

  @@map("actions")
}

model Permission {
  id           String    @id @default(cuid())
  systemCode   Int       @map("system_code")
  resourceCode Int       @map("resource_code")
  actionCode   Int       @map("action_code")
  key          String    @unique
  readableKey  String    @unique @map("readable_key")
  description  String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  deprecatedAt DateTime? @map("deprecated_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  resource            Resource                 @relation(fields: [systemCode, resourceCode], references: [systemCode, code], onDelete: Restrict)
  action              Action                   @relation(fields: [actionCode], references: [code], onDelete: Restrict)
  rolePermissions     RolePermission[]
  userRoleScopes      UserRoleScope[]
  permissionOverrides UserPermissionOverride[]

  @@unique([systemCode, resourceCode, actionCode])
  @@index([resourceCode])
  @@index([actionCode])
  @@map("permissions")
}

model Role {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  key         String
  name        String
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, key])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  companyId String    @map("company_id")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  scopes  UserRoleScope[]

  @@unique([userId, roleId, companyId])
  @@index([roleId])
  @@index([companyId])
  @@map("user_roles")
}

model UserRoleScope {
  id           String    @id @default(cuid())
  userRoleId   String    @map("user_role_id")
  scopeType    ScopeType @map("scope_type")
  systemCode   Int?      @map("system_code")
  resourceCode Int?      @map("resource_code")
  actionCode   Int?      @map("action_code")
  conditions   Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRole   UserRole              @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  permission Permission?           @relation(fields: [systemCode, resourceCode, actionCode], references: [systemCode, resourceCode, actionCode], onDelete: Restrict)
  branches   UserRoleScopeBranch[]

  @@index([userRoleId])
  @@index([systemCode, resourceCode, actionCode])
  @@map("user_role_scopes")
}

model UserRoleScopeBranch {
  id              String @id @default(cuid())
  userRoleScopeId String @map("user_role_scope_id")
  branchId        String @map("branch_id")

  scope  UserRoleScope @relation(fields: [userRoleScopeId], references: [id], onDelete: Cascade)
  branch Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([userRoleScopeId, branchId])
  @@index([branchId])
  @@map("user_role_scope_branches")
}

model UserPermissionOverride {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  companyId    String           @map("company_id")
  permissionId String           @map("permission_id")
  effect       PermissionEffect @default(ALLOW)
  scopeType    ScopeType        @default(COMPANY) @map("scope_type")
  conditions   Json?
  reason       String?          @db.Text
  startsAt     DateTime?        @map("starts_at") @db.Timestamptz(6)
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permission Permission                     @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  branches   UserPermissionOverrideBranch[]

  @@index([userId, companyId])
  @@index([permissionId])
  @@index([effect])
  @@map("user_permission_overrides")
}

model UserPermissionOverrideBranch {
  id         String @id @default(cuid())
  overrideId String @map("override_id")
  branchId   String @map("branch_id")

  override UserPermissionOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)
  branch   Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([overrideId, branchId])
  @@index([branchId])
  @@map("user_permission_override_branches")
}
