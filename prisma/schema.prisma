generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PermissionEffect {
  ALLOW @map("allow")
  DENY  @map("deny")

  @@map("permission_effect")
}

model Company {
  id         String    @id @default(cuid())
  name       String
  legalName  String?   @map("legal_name")
  nationalId String?   @unique @map("national_id")
  isActive   Boolean   @default(true) @map("is_active")
  settings   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  branches  Branch[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("companies")
}

model Branch {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  code      String
  name      String
  city      String?
  address   String?   @db.Text
  phone     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  users     User[]
  userRoles UserRole[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model User {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  branchId     String?   @map("branch_id")
  phone        String
  username     String?
  email        String?
  passwordHash String?   @map("password_hash")
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  isVerified   Boolean   @default(false) @map("is_verified")
  isActive     Boolean   @default(true) @map("is_active")
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")
  settings     Json      @default("{}")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  company             Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch              Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions            AuthSession[]
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  auditLogs           AuditLog[]

  @@unique([companyId, phone])
  @@unique([companyId, username])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([branchId])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model Subsystem {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  resources   Resource[]
  permissions Permission[]

  @@map("subsystems")
}

model Resource {
  id          String   @id @default(cuid())
  subsystemId String   @map("subsystem_id")
  code        String
  name        String
  tableName   String?  @map("table_name")
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subsystem   Subsystem    @relation(fields: [subsystemId], references: [id], onDelete: Restrict)
  permissions Permission[]

  @@unique([subsystemId, code])
  @@index([subsystemId])
  @@map("resources")
}

model Action {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions Permission[]

  @@map("actions")
}

model Permission {
  id          String   @id @default(cuid())
  subsystemId String   @map("subsystem_id")
  resourceId  String   @map("resource_id")
  actionId    String   @map("action_id")
  code        String   @unique
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subsystem           Subsystem                @relation(fields: [subsystemId], references: [id], onDelete: Restrict)
  resource            Resource                 @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  action              Action                   @relation(fields: [actionId], references: [id], onDelete: Restrict)
  rolePermissions     RolePermission[]
  permissionOverrides UserPermissionOverride[]

  @@unique([subsystemId, resourceId, actionId])
  @@index([resourceId])
  @@index([actionId])
  @@map("permissions")
}

model Scope {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions     RolePermission[]
  permissionOverrides UserPermissionOverride[]

  @@map("scopes")
}

model Role {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  code        String
  name        String
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  id           String           @id @default(cuid())
  roleId       String           @map("role_id")
  permissionId String           @map("permission_id")
  scopeId      String           @map("scope_id")
  effect       PermissionEffect @default(ALLOW)
  conditions   Json?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope      Scope      @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId, scopeId])
  @@index([permissionId])
  @@index([scopeId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  branchId  String?   @map("branch_id")
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, branchId])
  @@index([roleId])
  @@index([branchId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  permissionId String           @map("permission_id")
  scopeId      String           @map("scope_id")
  effect       PermissionEffect @default(ALLOW)
  conditions   Json?
  reason       String           @db.Text
  startsAt     DateTime?        @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?        @map("ends_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope      Scope      @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([permissionId])
  @@index([scopeId])
  @@map("user_permission_overrides")
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?  @map("company_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actorUser User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
